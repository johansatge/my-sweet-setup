# Font
font-family = Menlo
font-size = 12
font-thicken = true
font-thicken-strength = 50
adjust-cell-height = 6

# Window
window-padding-x = 6

# Scrollback
scrollback-limit = 10000

# Cursor
cursor-style = block
cursor-style-blink = false

# Colors (matching the VS Code theme)
split-divider-color = #b3b9c3
background = #fbfbfb
foreground = #474c50
cursor-color = #ee810c
selection-background = #d9e2f4
selection-foreground = #474c50

# Inherit working dir on new window, tab or split
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# ANSI palette (matching the VS Code theme)
palette = 0=#474c50
palette = 1=#df3939
palette = 2=#53af2d
palette = 3=#ee810c
palette = 4=#3073bf
palette = 5=#8f62bf
palette = 6=#3da2c9
palette = 7=#f6f7f9
palette = 8=#6a778a
palette = 9=#ee8c7a
palette = 10=#6cbf43
palette = 11=#e59000
palette = 12=#1390df
palette = 13=#b77adb
palette = 14=#58b4d5
palette = 15=#ffffff
